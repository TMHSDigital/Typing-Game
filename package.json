{
  "name": "typespeed",
  "version": "1.1.0",
  "private": true,
  "description": "Browser typing trainer. Plain HTML/CSS/JS, no build step.",
  "scripts": {
    "serve": "node scripts/serve.mjs",
    "test": "playwright test",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write \"*.{js,css,html,json,md}\" \"tests/**/*.js\" \"scripts/**/*.mjs\"",
    "format:check": "prettier --check \"*.{js,css,html,json,md}\" \"tests/**/*.js\" \"scripts/**/*.mjs\"",
    "check": "npm run lint && npm run format:check && npm test"
  },
  "license": "Apache-2.0",
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "prettier": "^3.10.0"
  }
}
